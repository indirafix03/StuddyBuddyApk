<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="@color/auth_bg">

    <ImageView
        android:id="@+id/img_study_buddy"
        android:layout_width="386dp"
        android:layout_height="318dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="70dp"
        android:layout_marginStart="120dp"
        android:contentDescription="StuddyBuddy Logo"
        android:src="@drawable/logo_trans" />

    <ImageView
        android:id="@+id/img_vector_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="300dp"
        android:scaleType="fitXY"
        android:contentDescription="Vector Background"
        android:src="@drawable/vektor1" />

    <TextView
        android:id="@+id/tv_login_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginTop="360dp"
        android:layout_marginStart="22dp"
        android:text="LOGIN"
        android:textColor="@color/auth_text_on_card"
        android:textSize="40sp"
        android:textStyle="bold" />

    <RelativeLayout
        android:id="@+id/container_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="450dp">

        <TextView
            android:id="@+id/tv_label_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textColor="@color/auth_text_secondary_on_card"
            android:textSize="16sp" />

        <RelativeLayout
            android:id="@+id/row_input_email"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_below="@id/tv_label_email"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/iv_email_icon"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_centerVertical="true"
                android:src="@drawable/img_email"
                app:tint="@color/auth_text_on_card"/>

            <View
                android:id="@+id/divider_email"
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_toEndOf="@id/iv_email_icon"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:background="@color/auth_text_on_card" />

            <EditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/divider_email"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="example: indira@gmail.com"
                android:textColorHint="@color/auth_text_secondary_on_card"
                android:textColor="@color/auth_text_on_card"
                android:textSize="14sp"
                android:inputType="textEmailAddress" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/row_input_email"
            android:layout_marginTop="4dp"
            android:background="@color/auth_text_on_card" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/container_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="530dp">

        <TextView
            android:id="@+id/tv_label_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textColor="@color/auth_text_secondary_on_card"
            android:textSize="16sp" />

        <RelativeLayout
            android:id="@+id/row_input_password"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_below="@id/tv_label_password"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/iv_password_icon"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_centerVertical="true"
                android:src="@drawable/img_password"
                app:tint="@color/auth_text_on_card"/>

            <View
                android:id="@+id/divider_password"
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_toEndOf="@id/iv_password_icon"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:background="@color/auth_text_on_card" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/divider_password"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="enter your password"
                android:textColorHint="@color/auth_text_secondary_on_card"
                android:textColor="@color/auth_text_on_card"
                android:textSize="14sp"
                android:inputType="textPassword" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/row_input_password"
            android:layout_marginTop="4dp"
            android:background="@color/auth_text_on_card" />
    </RelativeLayout>

    <Button
        android:id="@+id/btn_login"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="630dp"
        android:backgroundTint="@color/primary_brand"
        android:text="Login"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tv_go_to_register"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/btn_login"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="Don't have an account? Register here"
        android:textColor="@color/auth_text_secondary_on_card"
        android:textSize="14sp" />

</RelativeLayout>